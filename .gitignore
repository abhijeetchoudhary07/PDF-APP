# --- Android / Capacitor ---------------------------------------------------
# Generated by `npx cap add android`. The web bundle and native project are
# both reproducible from source, but the signing material is not: an upload key
# cannot be replaced once Play has seen it, so these patterns come first and
# deliberately cover every spelling of it.
*.jks
*.keystore
keystore.properties
android/keystore.properties
android/key.properties

# Capacitor regenerates these from `www/` on every `cap sync`.
android/app/src/main/assets/public/
android/app/src/main/res/xml/config.xml
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/captured-builds/
android/local.properties
app/keystore.properties
