# Refuse to install on a Node this toolchain cannot build with.
#
# `engines` in package.json is advisory by default: npm prints a warning and
# carries on. That is not enough here, because the failure it guards against is
# silent. On a Node below the Angular CLI's minimum, `ng build` prints
#
#     Node.js version v22.22.2 detected.
#     The Angular CLI requires a minimum Node.js version of v22.22.3 ...
#
# and then **exits 0 having emitted nothing at all**. A CI job that runs
# `npm ci && npm run build` goes green, uploads no bundle, and the first sign of
# trouble is a deploy serving whatever was there before.
#
# With engine-strict, the wrong Node fails at `npm ci` — loudly, before any
# build step gets the chance to look like it worked.
engine-strict=true
